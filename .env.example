NODE_ENV=development
PORT=3100

# MySQL (its own database, separate from inventory's)
DATABASE_URL=mysql://root:root@localhost:3306/config_inventory

# Auth - generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
COOKIE_SECURE=false
RUN_MIGRATIONS=false

# Shared with inventory (same values on both sides):
#   SERVICE_API_KEY        = inventory's CONFIG_SERVICE_KEY   (inventory asks us for company profiles)
#   INVENTORY_INTERNAL_KEY = inventory's INTERNAL_API_KEY     (we ask inventory to create company admins)
SERVICE_API_KEY=change-me-service-api-key-at-least-32-chars
INVENTORY_URL=http://localhost:3000
INVENTORY_INTERNAL_KEY=change-me-internal-key-at-least-32-chars

# The only person who can sign in here. Created by `pnpm db:seed`.
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=ChangeMe123!
SUPER_ADMIN_NAME=Super administrator