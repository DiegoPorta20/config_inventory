{
  "name": "config-inventory",
  "version": "0.1.0",
  "private": true,
  "description": "Internal back office that configures the companies using the inventory app (Angular + NestJS + MySQL)",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @config-inventory/api --filter @config-inventory/web run dev",
    "dev:api": "pnpm --filter @config-inventory/api dev",
    "dev:web": "pnpm --filter @config-inventory/web dev",
    "build": "pnpm --filter @config-inventory/web build && pnpm --filter @config-inventory/api build",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "db:generate": "pnpm --filter @config-inventory/api db:generate",
    "db:migrate": "pnpm --filter @config-inventory/api db:migrate",
    "db:seed": "pnpm --filter @config-inventory/api db:seed"
  },
  "devDependencies": {
    "prettier": "^3.4.2"
  }
}